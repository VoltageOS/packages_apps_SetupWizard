<com.google.android.setupdesign.GlifLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/setup_wizard_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        style="@style/SudContentFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/base_margin_top"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/setup_item_card_background"
            android:orientation="vertical"
            android:paddingStart="@dimen/control_card_padding_horizontal"
            android:paddingTop="@dimen/control_card_padding_vertical"
            android:paddingEnd="@dimen/control_card_padding_horizontal"
            android:paddingBottom="@dimen/control_card_padding_vertical">

            <com.google.android.setupdesign.view.RichTextView
                style="?attr/sudItemSummaryStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/appstore_description" />

            <ProgressBar
                android:id="@+id/appstore_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/control_card_margin_top"
                android:visibility="gone" />

            <com.google.android.setupdesign.view.RichTextView
                android:id="@+id/appstore_status"
                style="?attr/sudItemSummaryStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/control_card_margin_top"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/appstore_install_button"
            style="@style/Widget.Material3Expressive.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/control_card_margin_top"
            android:text="@string/appstore_install" />

    </LinearLayout>
</com.google.android.setupdesign.GlifLayout>
